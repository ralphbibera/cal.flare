{
  "name": "calflare-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "workspaces": [
    "apps/flare"
  ],
  "overrides": {
    "@vitejs/plugin-react": "6.1.1"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ],
  "scripts": {
    "setup": "bun apps/flare/scripts/setup.mjs",
    "dev": "bun run --cwd apps/flare dev",
    "build": "bun run --cwd apps/flare build",
    "preview": "bun run --cwd apps/flare preview",
    "type-check": "bun run --cwd apps/flare type-check",
    "type-check:ci": "bun run --cwd apps/flare type-check:ci",
    "lint": "bun run --cwd apps/flare lint && bun run --cwd apps/flare biome check ../../.agents/skills/verify-booking-reservations/resources/check.ts",
    "test": "bun run --cwd apps/flare test",
    "test:sqlite": "TZ=UTC python3 experiments/d1-reservations/verify.py",
    "verify:worker": "bun run --cwd apps/flare verify:worker",
    "verify:ui": "bun run --cwd apps/flare verify:ui",
    "type-check:formal": "bun run --cwd apps/flare tsc --noEmit --strict --skipLibCheck --target ESNext --module ESNext --moduleResolution bundler --types bun ../../.agents/skills/verify-booking-reservations/resources/check.ts",
    "verify:formal": "bun .agents/skills/verify-booking-reservations/resources/check.ts"
  },
  "patchedDependencies": {
    "miniflare@5.20261019.2-beta": "patches/miniflare@5.20261019.2-beta.patch",
    "miniflare@5.20261023.1-beta": "patches/miniflare@5.20261023.1-beta.patch",
    "wrangler@4.152.0": "patches/wrangler@4.152.0.patch",
    "esbuild@0.28.2": "patches/esbuild@0.28.2.patch",
    "workerd@1.20261019.1": "patches/workerd@1.20261019.1.patch",
    "workerd@1.20261023.1": "patches/workerd@1.20261023.1.patch"
  },
  "devDependencies": {
    "@types/bun": "1.3.14"
  }
}

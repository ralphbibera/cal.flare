---
import { env } from "cloudflare:workers";
import common from "../../../../packages/i18n/locales/en/common.json";
import { Button } from "../components/Button.tsx";
import { OwnerBookingRulesEditor } from "../components/OwnerBookingRulesEditor.tsx";
import OwnerBookings from "../components/OwnerBookings.astro";
import { OwnerEventEditor } from "../components/OwnerEventEditor.tsx";
import { OwnerOverridesEditor } from "../components/OwnerOverridesEditor.tsx";
import { OwnerScheduleEditor } from "../components/OwnerScheduleEditor.tsx";
import { getOwnerData } from "../server/app.ts";
import "../styles/globals.css";

type State =
  | { kind: "anonymous" | "unavailable" }
  | { kind: "owner"; data: NonNullable<Awaited<ReturnType<typeof getOwnerData>>> };
let state: State = { kind: "unavailable" };
try {
  const data = await getOwnerData(Astro.request, { env });
  state = data ? { kind: "owner", data } : { kind: "anonymous" };
} catch {
  state = { kind: "unavailable" };
}
Astro.response.status = state.kind === "unavailable" ? 503 : 200;
Astro.response.headers.set("Cache-Control", "private, no-store");
// Native form POSTs need a non-null Origin for the existing CSRF check.
Astro.response.headers.set("Referrer-Policy", "same-origin");
Astro.response.headers.set("X-Content-Type-Options", "nosniff");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{common.organizer} | Cal.flare</title>
  </head>
  <body class="bg-default text-default min-h-screen font-sans">
    <main class="relative flex min-h-screen items-center justify-center px-4 py-10">
      <section class="bg-default border-subtle w-full max-w-md rounded-xl border p-10 shadow-sm">
        <h1 class="text-emphasis mb-2 text-center text-xl font-bold">Cal.flare</h1>
        {state.kind === "anonymous" && (
          <>
            <p class="text-subtle mb-8 text-center text-sm">{common.welcome_back_sign_in}</p>
            <form action="/api/auth/login" method="get">
              <Button type="submit" className="w-full">{common.signin_with_google}</Button>
            </form>
            <p class="text-subtle mt-4 text-sm">{common.flare_owner_signin_help}</p>
          </>
        )}
        {state.kind === "owner" && (
          <div class="space-y-6">
            <div class="break-words">
              <h2 class="text-emphasis font-semibold">{common.organizer}</h2>
              <p>{state.data.owner.name}</p>
              <p class="text-subtle text-sm">{state.data.owner.email}</p>
            </div>
            <OwnerEventEditor client:load details={{
              title: state.data.settings.event.title, slug: state.data.settings.event.slug,
              description: state.data.settings.event.description, durationMinutes: state.data.settings.event.durationMinutes,
              location: state.data.settings.event.location,
            }} labels={{
              title: common.title, slug: common.slug, description: common.description,
              location: common.location, locationHelp: common.flare_event_location_help,
              locationLimit: common.max_limit_allowed_hint.replace("{{limit}}", "1000"),
              duration: common.duration, minutes: common.minutes, save: common.save,
              saved: common.saved, preview: common.preview, invalid: common.flare_event_details_invalid,
              failed: common.flare_event_details_failed, javascript: common.flare_event_details_javascript,
            }} />
            <OwnerBookingRulesEditor client:load rules={{
              intervalMinutes: state.data.settings.event.intervalMinutes, beforeMinutes: state.data.settings.event.beforeMinutes,
              afterMinutes: state.data.settings.event.afterMinutes, noticeMinutes: state.data.settings.event.noticeMinutes,
              disableCancelling: state.data.settings.event.disableCancelling ?? false,
              disableRescheduling: state.data.settings.event.disableRescheduling ?? false,
            }} labels={{
              heading: common.flare_booking_rules, intervalMinutes: common.slot_interval, beforeMinutes: common.before_event,
              afterMinutes: common.after_event, noticeMinutes: common.minimum_booking_notice,
              disableCancelling: common.disable_cancelling, disableRescheduling: common.disable_rescheduling,
              minutes: common.minutes, save: common.save, saved: common.saved, invalid: common.flare_booking_rules_invalid,
              failed: common.flare_booking_rules_failed, javascript: common.flare_booking_rules_javascript,
            }} />
            <OwnerScheduleEditor client:load schedule={{ timeZone: state.data.settings.schedule.timeZone,
              rules: state.data.settings.schedule.rules }} labels={{
              heading: common.flare_working_hours, zone: common.flare_time_zone, day: common.flare_working_day,
              interval: common.interval, start: common.start_time, end: common.end_time,
              add: common.add, remove: common.remove, save: common.save, saved: common.saved,
              invalid: common.flare_working_hours_invalid, failed: common.flare_working_hours_failed,
              midnight: common.flare_working_hours_midnight, empty: common.flare_working_hours_empty,
              javascript: common.flare_working_hours_javascript,
              weekdays: [common.sunday, common.monday, common.tuesday, common.wednesday,
                common.thursday, common.friday, common.saturday],
            }} />
            <OwnerOverridesEditor client:load overrides={state.data.settings.schedule.overrides ?? []} labels={{
              heading: common.date_overrides, date: common.date, interval: common.interval,
              start: common.start_time, end: common.end_time, addDate: common.add_an_override,
              add: common.add, remove: common.remove, delete: common.delete, save: common.save, saved: common.saved,
              invalid: common.flare_overrides_invalid, failed: common.flare_overrides_failed,
              help: common.flare_overrides_help, empty: common.flare_overrides_empty, closed: common.unavailable,
              midnight: common.flare_working_hours_midnight, javascript: common.flare_overrides_javascript,
            }} />
            <a href="/owner/bookings" class="text-default underline">{common.bookings}</a>
            <OwnerBookings bookings={state.data.bookings} timeZone={state.data.settings.schedule.timeZone} />
            <form action="/api/auth/logout" method="post" class="mt-6">
              <Button type="submit" color="secondary">{common.sign_out}</Button>
            </form>
          </div>
        )}
        {state.kind === "unavailable" && (
          <div class="space-y-4">
            <p role="alert">{common.flare_owner_unavailable}</p>
            <a class="text-default underline" href="/">{common.retry}</a>
          </div>
        )}
      </section>
    </main>
  </body>
</html>

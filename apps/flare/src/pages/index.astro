---
import { env } from "cloudflare:workers";
import common from "../../../../packages/i18n/locales/en/common.json";
import { Button } from "../components/Button.tsx";
import { OwnerBookingRulesEditor } from "../components/OwnerBookingRulesEditor.tsx";
import OwnerBookings from "../components/OwnerBookings.astro";
import { OwnerConflictCalendars } from "../components/OwnerConflictCalendars.tsx";
import { OwnerEventEditor } from "../components/OwnerEventEditor.tsx";
import { OwnerEventLifecycle } from "../components/OwnerEventLifecycle.tsx";
import { OwnerOverridesEditor } from "../components/OwnerOverridesEditor.tsx";
import { OwnerScheduleEditor } from "../components/OwnerScheduleEditor.tsx";
import { defaultSettings } from "../domain/settings.ts";
import { getOwnerEventData } from "../server/app.ts";
import { ErrorWithCode } from "../server/http.ts";
import "../styles/globals.css";

type State =
  | { kind: "anonymous" | "unavailable" | "invalid" }
  | { kind: "owner"; data: NonNullable<Awaited<ReturnType<typeof getOwnerEventData>>> };
let state: State = { kind: "unavailable" };
try {
  const data = await getOwnerEventData(Astro.request, { env });
  state = data ? { kind: "owner", data } : { kind: "anonymous" };
} catch (error) {
  state = {
    kind:
      error instanceof ErrorWithCode && ["not_found", "invalid_query"].includes(error.code)
        ? "invalid"
        : "unavailable",
  };
}
Astro.response.status = state.kind === "unavailable" ? 503 : state.kind === "invalid" ? 404 : 200;
Astro.response.headers.set("Cache-Control", "private, no-store");
// Native form POSTs need a non-null Origin for the existing CSRF check.
Astro.response.headers.set("Referrer-Policy", "same-origin");
Astro.response.headers.set("X-Content-Type-Options", "nosniff");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");
const details = state.kind === "owner" ? state.data.settings.event : defaultSettings.event;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{common.organizer} | Cal.flare</title>
  </head>
  <body class="bg-default text-default min-h-screen font-sans">
    <main class="relative flex min-h-screen items-center justify-center px-4 py-10">
      <section class="bg-default border-subtle w-full max-w-md rounded-xl border p-10 shadow-sm">
        <h1 class="text-emphasis mb-2 text-center text-xl font-bold">Cal.flare</h1>
        <a class="mb-6 block underline" href="/public/events">{common.flare_public_events}</a>
        {state.kind === "anonymous" && (
          <>
            <p class="text-subtle mb-8 text-center text-sm">{common.welcome_back_sign_in}</p>
            <form action="/api/auth/login" method="get">
              <Button type="submit" className="w-full">{common.signin_with_google}</Button>
            </form>
            <p class="text-subtle mt-4 text-sm">{common.flare_owner_signin_help}</p>
          </>
        )}
        {state.kind === "owner" && (
          <div class="space-y-6">
            <div class="break-words">
              <h2 class="text-emphasis font-semibold">{common.organizer}</h2>
              <p>{state.data.owner.name}</p>
              <p class="text-subtle text-sm">{state.data.owner.email}</p>
            </div>
            <nav aria-label={common.flare_owner_events} class="space-y-2">
              <h2 class="font-semibold">{common.flare_owner_events}</h2>
              {state.data.events.map((entry) => <a href={`/?eventId=${entry.id}`} aria-current={state.data.mode.kind === "edit" && entry.id === state.data.mode.id ? "page" : undefined} class="block break-words underline">{entry.event.title} /{entry.event.slug}</a>)}
              <a href="/?create=1" class="block underline" aria-current={state.data.mode.kind === "create" ? "page" : undefined}>{common.flare_create_event}</a>
            </nav>
            {state.data.mode.kind === "duplicate" && <a class="block underline" href={`/?eventId=${state.data.mode.id}`}>{common.back}</a>}
            <OwnerEventEditor client:load mode={state.data.mode} details={{
              title: details.title, slug: details.slug,
              description: details.description, durationMinutes: details.durationMinutes,
              location: details.location,
            }} labels={{
              title: common.title, slug: common.slug, description: common.description,
              location: common.location, locationHelp: common.flare_event_location_help,
              locationLimit: common.max_limit_allowed_hint.replace("{{limit}}", "1000"),
              duration: common.duration, minutes: common.minutes, save: common.save,
              saved: common.saved, preview: common.preview, invalid: common.flare_event_details_invalid,
              failed: common.flare_event_details_failed, javascript: common.flare_event_details_javascript,
              create: common.flare_create_event, uncertain: common.flare_event_create_uncertain,
              duplicate: common.flare_duplicate_event, duplicateHelp: common.flare_duplicate_help,
              refresh: common.flare_event_refresh, candidates: common.flare_event_candidates,
            }} />
            {state.data.mode.kind === "edit" && <OwnerEventLifecycle client:load id={state.data.mode.id} lifecycle={state.data.mode.lifecycle} labels={{
              heading: common.flare_event_visibility, hidden: common.flare_event_hidden,
              help: common.flare_event_visibility_help, save: common.save, saved: common.saved,
              failed: common.flare_event_visibility_failed, duplicate: common.flare_duplicate_event,
              remove: common.flare_remove_event, confirm: common.flare_remove_confirm,
              warning: common.flare_remove_warning, back: common.back,
              removeFailed: common.flare_remove_failed, javascript: common.flare_event_details_javascript,
            }} />}
            {state.data.mode.kind === "edit" && <OwnerBookingRulesEditor client:load eventId={state.data.mode.id} rules={{
              intervalMinutes: state.data.settings.event.intervalMinutes, beforeMinutes: state.data.settings.event.beforeMinutes,
              afterMinutes: state.data.settings.event.afterMinutes, noticeMinutes: state.data.settings.event.noticeMinutes,
              disableCancelling: state.data.settings.event.disableCancelling ?? false,
              disableRescheduling: state.data.settings.event.disableRescheduling ?? false,
              bookingWindowDays: state.data.settings.event.bookingWindowDays,
            }} labels={{
              heading: common.flare_booking_rules, intervalMinutes: common.slot_interval, beforeMinutes: common.before_event,
              afterMinutes: common.after_event, noticeMinutes: common.minimum_booking_notice,
              disableCancelling: common.disable_cancelling, disableRescheduling: common.disable_rescheduling,
              limitFutureBookings: common.limit_future_bookings, bookingWindowDays: common.flare_booking_window_days,
              windowHelp: common.flare_booking_window_help,
              minutes: common.minutes, save: common.save, saved: common.saved, invalid: common.flare_booking_rules_invalid,
              failed: common.flare_booking_rules_failed, javascript: common.flare_booking_rules_javascript,
            }} />}
            <OwnerConflictCalendars client:load selection={state.data.settings.conflictCalendarIds ?? null} labels={{
              heading: common.flare_conflict_calendars, help: common.flare_conflict_help,
              primary: common.flare_conflict_primary, default: common.flare_conflict_default,
              empty: common.flare_conflict_empty, unavailable: common.flare_conflict_unavailable,
              removeUnavailable: common.flare_conflict_remove_unavailable, loading: common.flare_conflict_loading,
              loadFailed: common.flare_conflict_load_failed, saveFailed: common.flare_conflict_save_failed,
              retry: common.flare_conflict_retry, reconnect: common.flare_conflict_reconnect,
              save: common.save, saved: common.saved, reset: common.flare_conflict_reset,
              clear: common.flare_conflict_clear, limit: common.flare_conflict_limit,
              javascript: common.flare_conflict_javascript,
            }} />
            <OwnerScheduleEditor client:load scheduleId={state.data.scheduleId} schedule={{ timeZone: state.data.settings.schedule.timeZone,
              rules: state.data.settings.schedule.rules }} labels={{
              heading: common.flare_working_hours, zone: common.flare_time_zone, day: common.flare_working_day,
              interval: common.interval, start: common.start_time, end: common.end_time,
              add: common.add, remove: common.remove, save: common.save, saved: common.saved,
              invalid: common.flare_working_hours_invalid, failed: common.flare_working_hours_failed,
              midnight: common.flare_working_hours_midnight, empty: common.flare_working_hours_empty,
              javascript: common.flare_working_hours_javascript,
              weekdays: [common.sunday, common.monday, common.tuesday, common.wednesday,
                common.thursday, common.friday, common.saturday],
            }} />
            <OwnerOverridesEditor client:load scheduleId={state.data.scheduleId} overrides={state.data.settings.schedule.overrides ?? []} labels={{
              heading: common.date_overrides, date: common.date, interval: common.interval,
              start: common.start_time, end: common.end_time, addDate: common.add_an_override,
              add: common.add, remove: common.remove, delete: common.delete, save: common.save, saved: common.saved,
              invalid: common.flare_overrides_invalid, failed: common.flare_overrides_failed,
              help: common.flare_overrides_help, empty: common.flare_overrides_empty, closed: common.unavailable,
              midnight: common.flare_working_hours_midnight, javascript: common.flare_overrides_javascript,
            }} />
            <a href="/owner/bookings" class="text-default underline">{common.bookings}</a>
            <OwnerBookings bookings={state.data.bookings} timeZone={state.data.bookingsTimeZone} />
            <form action="/api/auth/logout" method="post" class="mt-6">
              <Button type="submit" color="secondary">{common.sign_out}</Button>
            </form>
          </div>
        )}
        {(state.kind === "unavailable" || state.kind === "invalid") && (
          <div class="space-y-4">
            <p role="alert">{state.kind === "invalid" ? common.flare_event_not_found : common.flare_owner_unavailable}</p>
            <a class="text-default underline" href="/">{common.retry}</a>
          </div>
        )}
      </section>
    </main>
  </body>
</html>

{
  "name": "@calflare/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "type-check": "wrangler types && astro sync && tsc --noEmit",
    "type-check:ci": "bun scripts/type-check-ci.mjs",
    "lint": "biome check ../../package.json astro.config.mjs package.json postcss.config.mjs tsconfig.json wrangler.jsonc src scripts",
    "test": "bun run test:unit && bun run verify:d1",
    "test:unit": "bun test --parallel=4 --timeout 120000 ./scripts/*.test.ts",
    "verify:d1": "bun scripts/verify-d1.mjs",
    "verify:worker": "bun scripts/verify-worker.mjs",
    "verify:ui": "bun scripts/verify-ui.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/react": "7.0.0",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "astro": "7.4.2",
    "class-variance-authority": "0.4.0",
    "dayjs": "1.11.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-select": "5.10.2",
    "tailwind-merge": "1.13.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.1.15",
    "@tailwindcss/typography": "0.5.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "framer-motion": "10.12.8",
    "lucide-react": "0.555.0",
    "oxc-transform-react": "0.145.0",
    "postcss": "8.5.6",
    "react-timezone-select": "4.1.0",
    "tailwind-scrollbar": "4.0.2",
    "tailwindcss": "4.1.17",
    "tailwindcss-radix": "4.0.2",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "use-sync-external-store": "1.6.0",
    "wrangler": "4.152.0",
    "zod": "3.25.76",
    "zustand": "4.5.2"
  }
}

{
  "name": "@calcom/prisma",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "prisma-enum-generator": "./run-enum-generator.js"
  },
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf node_modules",
    "build": "prisma generate",
    "db-deploy": "bun run prisma migrate deploy",
    "db-deploy:d1": "bun run migrate-d1.mts",
    "db-migrate": "bun run prisma migrate dev",
    "db-nuke": "docker compose down --volumes --remove-orphans || docker-compose down --volumes --remove-orphans",
    "db-reset": "run-s db-nuke db-setup",
    "db-seed": "bun run prisma db seed",
    "db-setup": "run-s db-up db-deploy db-seed",
    "db-studio": "bun run prisma studio",
    "db-up": "docker compose up -d || docker-compose up -d",
    "dx": "bun run db-setup",
    "generate-schemas": "prisma generate",
    "generate-d1-domain": "bun run generate-d1-domain.mts",
    "post-install": "bun run generate-schemas",
    "seed-app-store": "ts-node --transpile-only ../../scripts/seed-app-store.ts",
    "delete-app": "ts-node --transpile-only ./delete-app.ts",
    "seed-basic": "ts-node --transpile-only ../../scripts/seed.ts",
    "seed-pbac": "ts-node --transpile-only ../../scripts/seed-pbac-organization.ts"
  },
  "dependencies": {
    "@prisma/adapter-d1": "6.16.3",
    "@prisma/adapter-pg": "6.16.3",
    "@prisma/client": "6.16.3",
    "@prisma/extension-accelerate": "1.3.0",
    "@prisma/generator-helper": "6.16.3",
    "prisma": "6.16.3",
    "prisma-kysely": "2.2.1",
    "uuid": "8.3.2",
    "zod": "3.25.76",
    "zod-prisma-types": "3.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "npm-run-all": "4.1.5",
    "ts-node": "10.9.2"
  },
  "main": "index.ts",
  "types": "index.d.ts",
  "files": [
    "client",
    "generated/prisma",
    "zod",
    "zod-utils.ts"
  ],
  "prisma": {
    "seed": "bun run seed-basic"
  }
}
